# Copy to .env and fill in. Never commit .env.

# --- LLM ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Voice (ElevenLabs, cloned voice) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- Stock footage ---
PEXELS_API_KEY=

# --- Cloudflare R2 (video hosting for Instagram) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=endo-videos

# --- Instagram Graph API (Business/Creator account) ---
IG_USER_ID=
IG_ACCESS_TOKEN=

# --- TikTok Content Posting API ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=

# --- Telegram alerts & weekly report (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Optional: use an installed Chrome for rendering (e.g. behind a corporate proxy) ---
# REMOTION_BROWSER_EXECUTABLE=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
