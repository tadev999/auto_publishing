{
  "name": "auto-publishing",
  "version": "0.1.0",
  "description": "AI agents that turn Endogenism articles into short videos and publish them to Instagram Reels & TikTok (Pure Node.js / TypeScript)",
  "type": "module",
  "bin": {
    "endo": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "endo": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "desktop:dev": "cd desktop && npm run dev",
    "desktop:build": "cd desktop && npm run build",
    "desktop:dist": "cd desktop && npm run dist",
    "remotion:studio": "cd remotion && npm run studio"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "better-sqlite3": "^11.8.1",
    "commander": "^13.1.0",
    "dotenv": "^16.4.7",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.1.0",
    "openai": "^4.86.0",
    "picocolors": "^1.1.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.17.24",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
